# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Alpha Vantage API key (https://www.alphavantage.co/support/#api-key).
# Required only when `data.provider` is set to `alphavantage` in config/settings.yaml.
ALPHAVANTAGE_API_KEY=your_key_here

# The SEC requires a descriptive User-Agent with a contact address on every
# request to data.sec.gov. Requests without one are refused.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: override the log level set in config/settings.yaml.
# QUANT_LOG_LEVEL=INFO
