GET / HTTP/1.1
Host: localhost:8080
API-Version: 2
Accept: application/hal+json

HTTP/1.1 200 OK
Content-Type: application/hal+json

{
  "_links": {
    "self": {
      "href": "http://localhost:8080/"
    },
    "bk:accounts": {
      "href": "http://localhost:8080/accounts"
    },
    "bk:instruments": {
      "href": "http://localhost:8080/instruments{?symbol,type}",
      "templated": true
    },
    "service-desc": {
      "href": "http://localhost:8080/openapi.yaml",
      "type": "application/openapi+yaml"
    },
    "service-doc": {
      "href": "https://docs.brokerage.example",
      "type": "text/html"
    },
    "bk:oauth-protected-resource": {
      "href": "http://localhost:8080/.well-known/oauth-protected-resource"
    },
    "curies": [
      {
        "href": "https://docs.brokerage.example/rels/{rel}",
        "name": "bk",
        "templated": true
      }
    ]
  },
  "description": "Accounts, positions, market data and trading, as hypermedia",
  "name": "Brokerage API"
}
